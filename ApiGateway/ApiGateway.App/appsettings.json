{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:5500",
      "http://127.0.0.1:5500"
    ]
  },

  "ReverseProxy": {

    "Routes": {

      "identityRoute": {
        "ClusterId": "identityCluster",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/identity" } ]
      },

      "catalogRoute": {
        "ClusterId": "catalogCluster",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/catalog" } ]
      },

      "loansRoute": {
        "ClusterId": "loansCluster",
        "Match": { "Path": "/loans/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/loans" } ]
      },

      "vendorsRoute": {
        "ClusterId": "vendorsCluster",
        "Match": { "Path": "/vendors/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/vendors" } ]
      }

    },

    "Clusters": {

      "identityCluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5086/api/" } }
      },

      "catalogCluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5080/api/" } }
      },

      "loansCluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5090/api/" } }
      },

      "vendorsCluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5100/api/" } }
      }

    }

  }
}