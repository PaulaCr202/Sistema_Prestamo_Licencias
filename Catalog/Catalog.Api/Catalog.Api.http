@identity = http://localhost:5086
@catalog = http://localhost:5080

### Login admin
# @name loginAdmin
POST {{identity}}/api/auth/login
Content-Type: application/json

{ "email": "admin@licencias.local", "password": "1234*" }

### Login usuario normal
# @name loginUser
POST {{identity}}/api/auth/login
Content-Type: application/json

{ "email": "user@licencias.local", "password": "1234" }

### 1. Listar software SIN token (debe dar 401)
GET {{catalog}}/api/software

### 2. Listar software con token de usuario normal (debe dar 200)
GET {{catalog}}/api/software
Authorization: Bearer {{loginUser.response.body.$.data.accessToken}}

### 3. Crear categoría con token de usuario normal (debe dar 403)
POST {{catalog}}/api/category
Authorization: Bearer {{loginUser.response.body.$.data.accessToken}}
Content-Type: application/json

{}

### 4. Crear categoría con token de admin (ya no da 401 ni 403; el resultado depende del cuerpo)
POST {{catalog}}/api/category
Authorization: Bearer {{loginAdmin.response.body.$.data.accessToken}}
Content-Type: application/json

{ "nombre": "Prueba" }